# Prisma (built from DB_* if DATABASE_URL omitted)
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis (for BullMQ queues)
REDIS_HOST=
REDIS_PORT=

# Email Service (MailHog for dev, SendGrid for prod)
NODE_ENV=
FROM_EMAIL=
MAILHOG_HOST=
MAILHOG_PORT=
SENDGRID_API_KEY=

# Server
PORT=3001
CORS_ORIGIN=

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=

# OAuth
GOOGLE_CLIENT_ID=

# Admin Bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
